# 쿠팡 순수익 계산기 환경변수
# 이 파일을 .env.local로 복사 후 사용하세요
# .env.local은 절대 git에 커밋하지 마세요

# 앱 환경 (개발: development, 배포: production)
NODE_ENV=development

# (선택) Vercel 배포 시 사용할 도메인
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# 참고: 쿠팡 API 키는 환경변수가 아닌 httpOnly 쿠키로 관리됩니다.
# 사용자가 설정 페이지에서 직접 입력 → 서버가 쿠키에 안전하게 저장합니다.
